generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(uuid())
  name           String?
  email          String          @unique
  phone          String?
  image          String?
  isBlocked      Boolean         @default(false)
  internalNotes  String?
  deletedAt      DateTime?
  deletedBy      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  addresses      Address[]
  cartItems      CartItem[]
  couponUsages   CouponUsage[]
  discountUsages DiscountUsage[]
  orders         Order[]
  returnRequests ReturnRequest[]
  reviews        Review[]
  userRoles      UserRole[]
  wishlistItems  WishlistItem[]

  @@index([email])
}

model UserRole {
  id        String       @id @default(uuid())
  userId    String
  role      UserRoleType
  grantedBy String?
  grantedAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
}

model AdminAuditLog {
  id        String   @id @default(uuid())
  adminId   String
  action    String
  entity    String
  entityId  String?
  payload   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([entity])
  @@index([createdAt])
}

model Category {
  id               String     @id @default(uuid())
  name             String     @unique
  slug             String     @unique
  description      String?
  parentId         String?
  thumbnailAssetId String?
  sortOrder        Int        @default(0)
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  parent           Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children         Category[] @relation("CategoryHierarchy")
  products         Product[]

  @@index([slug])
  @@index([parentId])
  @@map("categories")
}

model Brand {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  logoAssetId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([slug])
}

model Product {
  id                String             @id @default(uuid())
  name              String
  slug              String             @unique
  description       String
  shortDescription  String?
  price             Int
  discountPrice     Int?
  costPrice         Int?
  sku               String?            @unique
  stock             Int                @default(0)
  isActive          Boolean            @default(true)
  isFeatured        Boolean            @default(false)
  badge             String?
  weight            Float?
  details           String[]           @default([])
  careInstructions  String[]           @default([])
  tags              String[]           @default([])
  hsnCode           String?
  metaTitle         String?
  metaDescription   String?
  categoryId        String?
  brandId           String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  cartItems         CartItem[]
  flashSaleProducts FlashSaleProduct[]
  orderItems        OrderItem[]
  brand             Brand?             @relation(fields: [brandId], references: [id])
  category          Category?          @relation(fields: [categoryId], references: [id])
  images            ProductImage[]
  variants          ProductVariant[]
  productViews      ProductView[]
  reviews           Review[]
  wishlistItems     WishlistItem[]

  @@index([slug])
  @@index([categoryId])
  @@index([brandId])
  @@index([isActive, isFeatured])
  @@index([price])
  @@index([createdAt])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  assetId   String?
  url       String
  alt       String  @default("")
  publicId  String?
  color     String?
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id               String             @id @default(uuid())
  productId        String
  size             String
  color            String
  colorHex         String             @default("#000000")
  stock            Int                @default(0)
  reservedStock    Int                @default(0)
  sku              String?            @unique
  priceOverride    Int?
  cartItems        CartItem[]
  inventoryHistory InventoryHistory[]
  orderItems       OrderItem[]
  product          Product            @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, size, color])
  @@index([productId])
  @@map("product_variants")
}

model MediaAsset {
  id                  String       @id @default(uuid())
  filename            String
  originalFilename    String
  url                 String
  thumbnailUrl        String?
  mimeType            String
  sizeBytes           Int
  compressedSizeBytes Int?
  width               Int?
  height              Int?
  altText             String       @default("")
  folderId            String?
  tags                String[]     @default([])
  uploadedBy          String?
  createdAt           DateTime     @default(now())
  folder              MediaFolder? @relation(fields: [folderId], references: [id])

  @@index([folderId])
  @@index([createdAt])
}

model MediaFolder {
  id        String        @id @default(uuid())
  name      String
  parentId  String?
  createdAt DateTime      @default(now())
  assets    MediaAsset[]
  parent    MediaFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id])
  children  MediaFolder[] @relation("FolderHierarchy")

  @@index([parentId])
}

model CartItem {
  id        String          @id @default(uuid())
  userId    String?
  sessionId String?
  productId String
  variantId String?
  quantity  Int             @default(1)
  expiresAt DateTime?
  addedAt   DateTime        @default(now())
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([userId, productId, variantId])
  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt])
}

model Address {
  id             String  @id @default(uuid())
  userId         String
  label          String  @default("Home")
  fullName       String
  phone          String
  line1          String
  line2          String?
  city           String
  state          String
  postalCode     String
  country        String  @default("India")
  isDefault      Boolean @default(false)
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  shippingOrders Order[] @relation("ShippingAddress")
  billingOrders  Order[] @relation("BillingAddress")

  @@index([userId])
}

model Order {
  id                String               @id @default(uuid())
  orderNumber       String               @unique
  userId            String
  status            OrderStatus          @default(PENDING)
  paymentStatus     PaymentStatus        @default(PENDING)
  subtotal          Int
  discount          Int                  @default(0)
  shippingFee       Int                  @default(0)
  tax               Int                  @default(0)
  total             Int
  couponId          String?
  discountId        String?
  discountCode      String?
  addressId         String?
  billingAddressId  String?
  razorpayOrderId   String?
  razorpayPaymentId String?              @unique
  razorpaySignature String?
  paidAt            DateTime?
  trackingNumber    String?
  courierName       String?
  adminNotes        String?
  invoiceUrl        String?
  deletedAt         DateTime?
  deletedBy         String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  couponUsages      CouponUsage[]
  discountUsages    DiscountUsage[]
  invoice           Invoice?
  address           Address?             @relation("ShippingAddress", fields: [addressId], references: [id])
  billingAddress    Address?             @relation("BillingAddress", fields: [billingAddressId], references: [id])
  coupon            CouponCode?          @relation(fields: [couponId], references: [id])
  appliedDiscount   Discount?            @relation(fields: [discountId], references: [id])
  user              User                 @relation(fields: [userId], references: [id])
  items             OrderItem[]
  statusHistory     OrderStatusHistory[]
  returnRequests    ReturnRequest[]

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([createdAt])
  @@index([razorpayOrderId])
}

model OrderItem {
  id          String          @id @default(uuid())
  orderId     String
  productId   String
  variantId   String?
  productName String
  size        String?
  color       String?
  quantity          Int
  unitPrice         Int
  totalPrice        Int
  originalUnitPrice Int?
  discountAmount    Int?
  imageUrl          String?
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product         @relation(fields: [productId], references: [id])
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  returnItems ReturnItem[]

  @@index([orderId])
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  status    OrderStatus
  note      String?
  changedBy String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model ReturnRequest {
  id           String       @id @default(uuid())
  orderId      String
  userId       String
  status       ReturnStatus @default(PENDING)
  reason       String
  note         String?
  evidenceUrls String[]     @default([])
  adminNote    String?
  refundAmount Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  items        ReturnItem[]
  order        Order        @relation(fields: [orderId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([orderId])
  @@index([userId])
  @@index([status])
}

model ReturnItem {
  id              String        @id @default(uuid())
  returnRequestId String
  orderItemId     String
  quantity        Int
  reason          String?
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id])
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  @@index([returnRequestId])
}

model CouponCode {
  id               String        @id @default(uuid())
  code             String        @unique
  description      String?
  discountType     DiscountType
  discountValue    Int
  minOrderValue    Int?          @default(0)
  maxDiscount      Int?
  usageLimit       Int?
  usedCount        Int           @default(0)
  perCustomerLimit Int?
  applicableTo     String        @default("ALL")
  productIds       String[]      @default([])
  categoryIds      String[]      @default([])
  firstOrderOnly   Boolean       @default(false)
  isActive         Boolean       @default(true)
  startsAt         DateTime      @default(now())
  expiresAt        DateTime?
  createdAt        DateTime      @default(now())
  usageRecords     CouponUsage[]
  orders           Order[]

  @@index([code])
  @@index([isActive])
}

model CouponUsage {
  id              String     @id @default(uuid())
  couponId        String
  userId          String
  orderId         String
  discountApplied Int
  usedAt          DateTime   @default(now())
  coupon          CouponCode @relation(fields: [couponId], references: [id])
  order           Order      @relation(fields: [orderId], references: [id])
  user            User       @relation(fields: [userId], references: [id])

  @@index([couponId])
  @@index([userId])
}

model FlashSale {
  id        String             @id @default(uuid())
  name      String
  startAt   DateTime
  endAt     DateTime
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  products  FlashSaleProduct[]

  @@index([startAt, endAt])
  @@index([isActive])
}

model FlashSaleProduct {
  id          String    @id @default(uuid())
  flashSaleId String
  productId   String
  salePrice   Int
  flashSale   FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([flashSaleId, productId])
}

model NewsletterSubscriber {
  id             String    @id @default(uuid())
  email          String    @unique
  isActive       Boolean   @default(true)
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([email])
  @@index([isActive])
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  addedAt   DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

model Review {
  id                 String   @id @default(uuid())
  productId          String
  userId             String
  rating             Int
  title              String?
  body               String?
  isVerifiedPurchase Boolean  @default(false)
  isApproved         Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@index([rating])
}

model CmsContent {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@index([key])
}

model CmsPage {
  id              String   @id @default(uuid())
  slug            String   @unique
  title           String
  content         Json
  metaTitle       String?
  metaDescription String?
  isPublished     Boolean  @default(false)
  updatedBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([slug])
  @@index([isPublished])
}

model NavigationMenu {
  id        String   @id @default(uuid())
  location  String   @unique
  items     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model NotificationLog {
  id             String    @id @default(uuid())
  type           String
  channel        String
  recipientEmail String?
  recipientPhone String?
  orderId        String?
  status         String    @default("PENDING")
  payload        Json?
  sentAt         DateTime?
  error          String?
  createdAt      DateTime  @default(now())

  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model NotificationSetting {
  id        String   @id @default(uuid())
  type      String   @unique
  channel   String
  isEnabled Boolean  @default(true)
  template  String?
  updatedAt DateTime @updatedAt
}

model InvoiceSetting {
  id            String   @id @default(uuid())
  businessName  String
  address       String
  state         String
  gstin         String
  invoicePrefix String   @default("AUTH")
  cgstRate      Decimal  @default(9)
  sgstRate      Decimal  @default(9)
  igstRate      Decimal  @default(18)
  updatedAt     DateTime @updatedAt
}

model Invoice {
  id            String   @id @default(uuid())
  orderId       String   @unique
  invoiceNumber String   @unique
  invoiceUrl    String?
  issuedAt      DateTime @default(now())
  order         Order    @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model InventoryHistory {
  id             String         @id @default(uuid())
  variantId      String
  changeType     String
  quantityBefore Int
  quantityAfter  Int
  reason         String?
  adminId        String?
  createdAt      DateTime       @default(now())
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@index([createdAt])
}

model ProductView {
  id        String   @id @default(uuid())
  productId String
  userId    String?
  sessionId String?
  viewedAt  DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, viewedAt])
}

model WebhookLog {
  id          String    @id @default(uuid())
  provider    String
  eventType   String
  eventId     String    @unique
  payload     Json
  status      String    @default("PROCESSING")
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@index([eventId])
  @@index([provider, createdAt])
}

enum UserRoleType {
  SUPER_ADMIN
  ADMIN
  OPERATIONS
  MARKETING
  SUPPORT
  VIEWER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
}

model Discount {
  id             String          @id @default(uuid())
  code           String          @unique
  type           String          // 'percentage' | 'flat'
  value          Decimal         @db.Decimal(10, 2)
  minOrderValue  Decimal         @default(0) @db.Decimal(10, 2)
  maxUses        Int?            // NULL = unlimited
  usedCount      Int             @default(0)
  isActive       Boolean         @default(true)
  expiresAt      DateTime?       // NULL = never expires
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  usages         DiscountUsage[]
  orders         Order[]

  @@map("discounts")
}

model DiscountUsage {
  id         String   @id @default(uuid())
  discountId String
  userId     String
  orderId    String
  usedAt     DateTime @default(now())
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id])
  order      Order    @relation(fields: [orderId], references: [id])

  @@index([discountId])
  @@index([userId])
  @@map("discount_usage")
}

model HomepageSection {
  id        String   @id @default(uuid())
  type      String   // 'hero' | 'featured_products' | 'banner' | 'category_grid' | 'announcement'
  title     String?
  subtitle  String?
  imageUrl  String?
  ctaText   String?
  ctaLink   String?
  sortOrder Int      @default(0)
  isVisible Boolean  @default(true)
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("homepage_sections")
}

model MediaLibrary {
  id         String   @id @default(uuid())
  fileName   String
  fileUrl    String
  fileType   String?
  fileSize   Int?
  bucketPath String?
  uploadedBy String?
  createdAt  DateTime @default(now())

  @@map("media_library")
}

model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String?
  group     String?  // 'general' | 'seo' | 'payment' | 'shipping' | 'social'
  label     String?
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

model OrderSequence {
  name      String   @id
  value     Int
  updatedAt DateTime @updatedAt

  @@map("order_sequences")
}

